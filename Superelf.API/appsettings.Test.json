{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-test;Port=5432;Database=SuperelfDbTest;Username=postgres;Password=${TEST_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://superelf-test.yorickteriele.nl"
  ],
  "JwtSettings": {
    "Key": "${TEST_JWT_SECRET}",
    "Issuer": "SuperelfAPI",
    "Audience": "SuperelfClient",
    "ExpiryInMinutes": 60
  }
}
