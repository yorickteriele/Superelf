{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-prod;Port=5432;Database=SuperelfDb;Username=postgres;Password=${PROD_DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://superelf.yorickteriele.nl"
  ],
  "JwtSettings": {
    "Key": "${PROD_JWT_SECRET}",
    "Issuer": "SuperelfAPI",
    "Audience": "SuperelfClient",
    "ExpiryInMinutes": 60
  },
  "GoogleCalendar": {
    "ApiKey": "<GOOGLE_CALENDAR_API_KEY>"
  },
  "ImageStorage": {
    "Directory": "/app/images/players"
  }
}
